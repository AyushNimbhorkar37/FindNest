<% layout("/layouts/boilerplate") -%>

    <body>
        <div class="row mt-3">
            <div class="col-8 offset-2">

                <h3>Edit the Listing :</h3><br>
                <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate
                    class="needs-validation">

                    <div class="mb-4">
                        <label for="title" class="form-label">Title :</label>
                        <input type="text" name="listing[title]" class="form-control" required
                            value="<%= listing.title %>">
                        <div class="valid-feedback">Title looks good!</div>
                        <div class="invalid-feedback">Enter a valid title</div>
                    </div>

                    <div class="mb-4">
                        <label for="description" class="form-label">Description :</label>
                        <textarea name="listing[description]" class="form-control"
                            required><%= listing.description %></textarea>
                        <div class="invalid-feedback">Please enter a short description</div>
                    </div>

                    <div class="mb-4">
                        <label for="image" class="form-label">Image Link :</label>
                        <input type="text" name="listing[image][url]" class="form-control" required
                            value="<%= listing.image.url %>">
                        <div class="invalid-feedback">Please enter image URL</div>
                    </div>

                    <div class="row">
                        <div class="mb-4 col-md-5">
                            <label for="price" class="form-label">Price :</label>
                            <input type="text" name="listing[price]" class="form-control" required
                                value="<%= listing.price %>">
                            <div class="invalid-feedback">Please enter valid Price</div>
                        </div>

                        <div class="mb-4 col-md-7">
                            <label for="country" class="form-label">Country :</label>
                            <input type="text" name="listing[country]" class="form-control" required
                                value="<%= listing.country %>">
                            <div class="invalid-feedback">Country name should be valid</div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="location" class="form-label">Location :</label>
                        <input type="text" name="listing[location]" class="form-control" required
                            value="<%= listing.location %>">
                         <div class="invalid-feedback">Location should be valid</div>
                    </div>

                    <button class="btn btn-dark edit-btn mb-3">Save</button><br>
                </form>
            </div>
        </div>
    </body>